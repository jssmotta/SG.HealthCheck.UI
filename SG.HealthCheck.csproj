<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Meta-package aggregating SG health check stack dependencies (NuGet id: SG.HealthChecks). -->
    <PackageId>SG.HealthChecks</PackageId>
    <Version>1.0.1</Version>
    <Authors>Jefferson S. Motta</Authors>
    <Company>Menphis Sistemas Inteligentes</Company>
    <Copyright>Copyright © Menphis Sistemas Inteligentes</Copyright>
    <Description>Meta-package referencing Microsoft.Extensions.Diagnostics.HealthChecks, EF Core SQL Server, HTTP, and related dependencies used by SG / Source Genesys health check stacks.</Description>
    <PackageDescription>$(Description)</PackageDescription>
    <PackageTags>healthcheck;healthchecks;aspnetcore;sg;sourcegenesys;menphissi;sqlserver;efcore</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jssmotta/SG.HealthCheck.UI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jssmotta/SG.HealthCheck.UI.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PACKAGE_VERSION)' != ''">
    <Version>$(PACKAGE_VERSION)</Version>
    <PackageVersion>$(PACKAGE_VERSION)</PackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Hosting.Server.Abstractions" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
    <PackageReference Include="Duende.IdentityModel" />
  </ItemGroup>
  <!-- Exclude compiled/generated files from nested projects (obj/bin folders) when building this root project
       This prevents duplicate assembly attributes (TargetFrameworkAttribute) coming from other projects' obj folders
       which are discovered by the SDK default globbing when the project is located at the repository root. -->
  <ItemGroup>
    <Compile Remove="**/obj/**" />
    <Compile Remove="**/bin/**" />
    <None Remove="**/obj/**" />
    <None Remove="**/bin/**" />
    <!-- Do not compile sources from the 'src' folder; those are separate projects with their own csproj files -->
    <Compile Remove="src/**/*.cs" />
    <EmbeddedResource Remove="src/**/*" />
    <None Remove="src/**/*" />
  </ItemGroup>
</Project>
